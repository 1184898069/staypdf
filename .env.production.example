# Production environment for the StayPDF API (Docker / Railway / Fly / Render).
# Copy to .env.production (or set as host secrets). Never commit real secrets.
# STAYPDF_TEST_* must NOT be set in Production (DevSeed ignores non-Development).

ASPNETCORE_ENVIRONMENT=Production

# Required: 32+ characters
JWT_SECRET=replace-with-at-least-32-characters-secret!!

# Required in Production (Cloudflare Turnstile secret key)
TURNSTILE_SECRET=replace-with-turnstile-secret

# Public UI origin (verify-email links). Include the Pages path.
APP_PUBLIC_URL=https://1184898069.github.io/staypdf

# Comma-separated. Must include the GitHub Pages origin (no path).
CORS_ORIGINS=https://1184898069.github.io

# SQLite on a persistent volume (Docker image default). Override if needed.
ConnectionStrings__Default=Data Source=/data/staypdf.db

# Registration email (required for /api/auth/register in Production; else 503)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# Optional: listen port (Railway/Fly/Render inject PORT automatically)
PORT=8080
