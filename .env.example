# Copy to .env and fill in real values. Never commit .env.
ASPNETCORE_ENVIRONMENT=Development
JWT_SECRET=replace-with-at-least-32-characters-secret
STAYPDF_TEST_EMAIL=you@example.com
STAYPDF_TEST_PASSWORD=replace-with-your-password
VITE_API_URL=http://localhost:5080
APP_PUBLIC_URL=http://localhost:5173
CORS_ORIGINS=http://localhost:5173,http://localhost:4173,http://127.0.0.1:5173,http://127.0.0.1:4173,https://1184898069.github.io

# Optional in Development. Required in Production.
TURNSTILE_SECRET=
VITE_TURNSTILE_SITE_KEY=

# Production mail. If missing in Production, registration returns 503.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
